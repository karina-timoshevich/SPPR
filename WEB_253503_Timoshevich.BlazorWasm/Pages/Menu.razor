@page "/menu"
<PageTitle>Menu</PageTitle>

<h3>Меню дня</h3>

<CategorySelector /> <!-- Добавляем компонент выбора категории -->
<DishesList /> <!-- Отображаем список объектов -->
@code {
    [Inject] public IDataService DataService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Загружаем список блюд при инициализации страницы
        await DataService.GetProductListAsync(1);
    }
}
