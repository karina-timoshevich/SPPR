@page "/menu"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<h3>Меню дня</h3>
<CategorySelector />
<DishesList />
<Pager />
@code {
    [Inject] public IDataService DataService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!DataService.Categories.Any())
        {
            await DataService.GetCategoryListAsync();  // Загружаем список категорий
            StateHasChanged(); // Принудительное обновление компонента
        }
    }
}